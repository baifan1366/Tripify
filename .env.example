# Supabase: Project Connect / API Keys. Auth setup: docs/AUTH_SETUP.md
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Google Client ID/Secret belong in Supabase's Google provider settings, NOT here.
# Server only. Use only in trusted server code; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (server-side Tripify AI graph only; never NEXT_PUBLIC_, never commit real keys).
# Single key (simplest):
OPENROUTER_API_KEY=your_openrouter_api_key
# ...or a rotation pool. When a key hits a limit (401/402/429/quota), the
# server silently retries the same request with the next key:
# OPENROUTER_API_KEYS=key_aaa,key_bbb
# OPEN_ROUTER_KEY_1=your_first_key
# OPEN_ROUTER_KEY_2=your_second_key
# (OPENROUTER_API_KEY_1.._20 and OPEN_ROUTER_KEY_1.._20 are also read.)
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# Free models: 50 requests/day per account without purchased credits,
# 1000/day with $10+ credits (OpenRouter docs). Each chat turn costs
# several requests, so buy credits before any real usage.

# Optional, sent to OpenRouter as application attribution
# Auth ignores this value: NODE_ENV=production uses https://tripify-agent.vercel.app;
# next dev uses http://localhost:3000. Do not manually override NODE_ENV here.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Maps: browser key restricted by HTTP referrer + Maps JavaScript / Places API (New).
# See docs/SHARED_MVP_IMPLEMENTATION.md. Missing configuration keeps the fallback usable.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Server only: restrict to Routes API + Time Zone API. Never use a NEXT_PUBLIC_ prefix.
GOOGLE_MAPS_SERVER_API_KEY=

# Debug logging (never commit real keys; debug output never includes them).
# Browser: NEXT_PUBLIC_DEBUG=1, or localStorage "tripify:debug"="1", or URL ?debug
# Server (Vercel logs): MAPS_DEBUG=1 (maps only) or TRIPIFY_DEBUG=1 (all).
# NEXT_PUBLIC_DEBUG=
# MAPS_DEBUG=
