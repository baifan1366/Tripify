# Supabase: Project Connect / API Keys. Auth setup: docs/AUTH_SETUP.md
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Google Client ID/Secret belong in Supabase's Google provider settings, NOT here.
# Server only. Use only in trusted server code; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (used by LangChain; switch models without changing application code)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Optional, sent to OpenRouter as application attribution
NEXT_PUBLIC_APP_URL=http://localhost:3000
